    { "type": "text", "id": "t1", "x": 12, "y": 60, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 2, "version": 1, "versionNonce": 2, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c1", "lineHeight": 1.25,
      "text": "EV — Valor Esperado\nLucro médio por aposta se o\ncenário se repetisse muitas vezes.\nNegativo = tendência de perder.",
      "originalText": "EV — Valor Esperado\nLucro médio por aposta se o\ncenário se repetisse muitas vezes.\nNegativo = tendência de perder." },

    { "type": "rectangle", "id": "c2", "x": 350, "y": 45, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": {"type":3}, "seed": 3, "version": 1, "versionNonce": 3, "isDeleted": false,
      "boundElements": [{"type":"text","id":"t2"}], "updated": 1, "link": null, "locked": false },
    { "type": "text", "id": "t2", "x": 362, "y": 60, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 4, "version": 1, "versionNonce": 4, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c2", "lineHeight": 1.25,
      "text": "ROI — Retorno sobre Investimento\nLucro ÷ capital investido × 100.\nMede quanto rendeu o dinheiro\nque você colocou.",
      "originalText": "ROI — Retorno sobre Investimento\nLucro ÷ capital investido × 100.\nMede quanto rendeu o dinheiro\nque você colocou." },

    { "type": "rectangle", "id": "c3", "x": 700, "y": 45, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": {"type":3}, "seed": 5, "version": 1, "versionNonce": 5, "isDeleted": false,
      "boundElements": [{"type":"text","id":"t3"}], "updated": 1, "link": null, "locked": false },
    { "type": "text", "id": "t3", "x": 712, "y": 60, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 6, "version": 1, "versionNonce": 6, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c3", "lineHeight": 1.25,
      "text": "WR — Win Rate (taxa de acerto)\nAcertos ÷ total de jogos.\nSozinha engana: 95% pagando\nodd 1.02 dá prejuízo.",
      "originalText": "WR — Win Rate (taxa de acerto)\nAcertos ÷ total de jogos.\nSozinha engana: 95% pagando\nodd 1.02 dá prejuízo." },

    { "type": "rectangle", "id": "c4", "x": 1050, "y": 45, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
