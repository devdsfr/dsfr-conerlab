    { "type": "text", "id": "t5", "x": 12, "y": 195, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 10, "version": 1, "versionNonce": 10, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c5", "lineHeight": 1.25,
      "text": "DD — Drawdown\nMaior queda entre um pico e o\nvale seguinte da banca.\nO pior momento do caminho.",
      "originalText": "DD — Drawdown\nMaior queda entre um pico e o\nvale seguinte da banca.\nO pior momento do caminho." },

    { "type": "rectangle", "id": "c6", "x": 350, "y": 180, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": {"type":3}, "seed": 11, "version": 1, "versionNonce": 11, "isDeleted": false,
      "boundElements": [{"type":"text","id":"t6"}], "updated": 1, "link": null, "locked": false },
    { "type": "text", "id": "t6", "x": 362, "y": 195, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 12, "version": 1, "versionNonce": 12, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c6", "lineHeight": 1.25,
      "text": "PF — Profit Factor\nLucro bruto ÷ prejuízo bruto.\nAcima de 1 = ganhou mais do\nque perdeu.",
      "originalText": "PF — Profit Factor\nLucro bruto ÷ prejuízo bruto.\nAcima de 1 = ganhou mais do\nque perdeu." },

    { "type": "rectangle", "id": "c7", "x": 700, "y": 180, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": {"type":3}, "seed": 13, "version": 1, "versionNonce": 13, "isDeleted": false,
      "boundElements": [{"type":"text","id":"t7"}], "updated": 1, "link": null, "locked": false },
    { "type": "text", "id": "t7", "x": 712, "y": 195, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 14, "version": 1, "versionNonce": 14, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c7", "lineHeight": 1.25,
      "text": "RF — Recovery Factor\nLucro líquido ÷ drawdown máximo.\nSe o lucro compensa o tombo\nque você levou no caminho.",
      "originalText": "RF — Recovery Factor\nLucro líquido ÷ drawdown máximo.\nSe o lucro compensa o tombo\nque você levou no caminho." },

    { "type": "rectangle", "id": "c8", "x": 1050, "y": 180, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
