    { "type": "text", "id": "t8", "x": 1062, "y": 195, "width": 306, "height": 85, "angle": 0,
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null,
      "roundness": null, "seed": 16, "version": 1, "versionNonce": 16, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "containerId": "c8", "lineHeight": 1.25,
      "text": "CAGR — Crescimento Anual Composto\nTaxa média de crescimento da\nbanca por ano. Permite comparar\nperíodos de duração diferente.",
      "originalText": "CAGR — Crescimento Anual Composto\nTaxa média de crescimento da\nbanca por ano. Permite comparar\nperíodos de duração diferente." },

    { "type": "rectangle", "id": "c9", "x": 0, "y": 315, "width": 330, "height": 115, "angle": 0,
      "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2,
