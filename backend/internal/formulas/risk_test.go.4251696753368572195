func TestSharpeAdapted(t *testing.T) {
	cases := []struct{ mean, rf, sd, want float64 }{
		{10, 0, 5, 2.0},
		{10, 2, 4, 2.0},
		{5, 5, 10, 0},
		{-5, 0, 5, -1.0},
		{25, 5, 10, 2.0},
		{8, 0, 16, 0.5},
		{12, 2, 5, 2.0},
		{3, 1, 1, 2.0},
		{100, 0, 50, 2.0},
		{7, 7, 3, 0},
	}
	for _, c := range cases {
		got, err := SharpeAdapted(c.mean, c.rf, c.sd)
		noErr(t, err, "SharpeAdapted")
		approx(t, got, c.want, "SharpeAdapted")
	}
	if _, err := SharpeAdapted(10, 0, 0); err == nil {
		t.Error("desvio 0 deveria falhar")
	}
}

