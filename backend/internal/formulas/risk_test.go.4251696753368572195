package formulas

import "testing"

func TestVarianceAndStdDev(t *testing.T) {
	cases := []struct {
		values   []float64
		variance float64
		stddev   float64
	}{
		{[]float64{5, 5, 5, 5}, 0, 0},           // sem variação
		{[]float64{1, 2, 3, 4, 5}, 2, 1.4142},
		{[]float64{2, 4, 4, 4, 5, 5, 7, 9}, 4, 2},
		{[]float64{10}, 0, 0},                    // um único valor
		{[]float64{0, 10}, 25, 5},
		{[]float64{-5, 5}, 25, 5},                // valores negativos permitidos
		{[]float64{1, 1, 1, 7}, 6.75, 2.5981},
		{[]float64{3, 3, 6, 6}, 2.25, 1.5},
		{[]float64{100, 100, 100}, 0, 0},
		{[]float64{0, 0, 0, 12}, 27, 5.1962},
	}
	for _, c := range cases {
		v, err := Variance(c.values)
		noErr(t, err, "Variance")
		approx(t, v, c.variance, "Variance")
		s, err := StdDev(c.values)
		noErr(t, err, "StdDev")
		approx(t, s, c.stddev, "StdDev")
	}
	if _, err := Variance(nil); err == nil {
		t.Error("série vazia deveria falhar")
	}
	if _, err := StdDev([]float64{}); err == nil {
		t.Error("série vazia deveria falhar")
	}
}

func TestMaxDrawdown(t *testing.T) {
	cases := []struct {
		equity []float64
		want   float64
	}{
		{[]float64{100, 110, 120}, 0},              // só subiu
		{[]float64{100, 80}, 0.20},                 // queda direta de 20%
		{[]float64{100, 120, 90, 130}, 0.25},       // pico 120 → vale 90
		{[]float64{100, 50, 100}, 0.50},            // recuperou depois
		{[]float64{100}, 0},                        // um ponto só
		{[]float64{100, 100, 100}, 0},              // flat
		{[]float64{100, 90, 80, 70}, 0.30},         // queda contínua
		{[]float64{100, 200, 100, 300, 150}, 0.50}, // maior queda entre dois picos
		{[]float64{10, 5, 20, 10}, 0.50},
		{[]float64{100, 0}, 1.0},                   // ruína total
	}
	for i, c := range cases {
		got, err := MaxDrawdown(c.equity)
		noErr(t, err, "MaxDrawdown")
		approx(t, got, c.want, "MaxDrawdown")
		_ = i
	}
	if _, err := MaxDrawdown(nil); err == nil {
		t.Error("série vazia deveria falhar")
	}
	if _, err := MaxDrawdown([]float64{100, -10}); err == nil {
		t.Error("equity negativa deveria falhar")
	}
}

